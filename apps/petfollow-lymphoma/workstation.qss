/* Local imaging workspace: image canvas, work surfaces, and a single action color. */
QWidget {
    color: #e2ebf2;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 14px;
}
QMainWindow, QWidget#workstation { background: #0c121b; }
QDialog, QMessageBox { background: #141d29; }
QFrame#bannerStrip { background: #30291e; border-bottom: 1px solid #4d3e29; }
QLabel#banner { color: #edc786; font-weight: 600; font-size: 12px; }
QLabel#bannerNote { color: #c4aa83; font-size: 12px; }
QLabel#dialogBanner { background: #352d20; color: #f1ca88; padding: 7px 12px; border-radius: 5px; }
QFrame#commandBar { background: #151f2b; border-bottom: 1px solid #273443; }
QLabel#title { font-size: 21px; font-weight: 600; color: #f2f6fa; }
QLabel#subtitle { color: #94a7b8; font-size: 12px; }
QFrame#verticalDivider { background: #354452; }
QFrame#contextBar { background: #101924; border-bottom: 1px solid #263340; }
QLabel#eyebrow, QLabel#field, QLabel#muted { color: #a1b3c3; font-size: 12px; }
QLabel#contextValue { color: #e3eef4; font-size: 14px; font-weight: 600; }
QLabel#synthetic, QLabel#sourceBadge, QLabel#editMode, QLabel#count, QLabel#statusTag {
    padding: 2px 7px; border-radius: 5px; font-weight: 600; font-size: 12px;
}
QLabel#synthetic { color: #eac785; background: #372f21; }
QLabel#sourceBadge, QLabel#statusTag { color: #9ed9c8; background: #17352f; }
QLabel#editMode, QLabel#count { color: #add7d2; background: #203c40; }
QLabel#section { font-size: 16px; font-weight: 600; color: #edf4f8; }
QLabel#reviewReason { background: #382e21; color: #f1cf91; border-radius: 5px; padding: 7px 9px; }
QPushButton {
    background: #223140; color: #dbe7ef; border: 1px solid transparent; border-radius: 6px;
    padding: 5px 10px; min-height: 20px;
}
QPushButton:hover { background: #2d4152; color: #f4f9fc; }
QPushButton:pressed { background: #1b2935; }
QPushButton:focus { border-color: #709aa6; }
QPushButton#action { background: transparent; }
QPushButton#action:hover, QPushButton#quietAction:hover { background: #263745; }
QPushButton#action:pressed, QPushButton#quietAction:pressed { background: #1d2c38; }
QPushButton#primary { background: #78d9c9; color: #102d30; font-weight: 600; }
QPushButton#primary:hover { background: #91e5d7; }
QPushButton#primary:pressed { background: #62c4b6; }
QPushButton#primary:focus { border-color: #c4fff1; }
QPushButton#primary:disabled { color: #839b9f; background: #253940; }
QPushButton:disabled, QPushButton#action:disabled, QPushButton#quietAction:disabled { color: #748493; }
QPushButton#smallAction { background: #21383c; color: #afe1d7; font-size: 12px; padding: 2px 8px; }
QPushButton#smallAction:hover { background: #2c494d; }
QPushButton#quietAction { background: transparent; color: #afd7d4; padding: 2px 5px; font-size: 12px; }
QFrame#sidebar, QScrollArea#inspectorScroll, QTabWidget#inspectorTabs::pane {
    background: #151e29; border: none;
}
QTabWidget#inspectorTabs { background: #151e29; }
QTabBar { background: #151e29; }
QTabBar::tab {
    background: #151e29; color: #97aabc; border: 0; border-bottom: 2px solid #23313e;
    min-width: 94px; padding: 8px 10px; font-weight: 600; font-size: 13px;
}
QTabBar::tab:hover { background: #1d2b38; color: #ddeaf0; }
QTabBar::tab:selected { color: #a5e4d9; border-bottom-color: #76d5c6; }
QTableWidget {
    background: #121b26; alternate-background-color: #172330; selection-background-color: #244342;
    selection-color: #ecfff9; gridline-color: #293542; border: 0; border-radius: 4px;
}
QTableWidget::item { padding: 3px 6px; }
QTableWidget::item:selected { background: #244342; color: #e8faf7; }
QTableWidget#lesionsTable::item { border-bottom: 1px solid #23303d; }
QHeaderView { background: #1d2b38; }
QHeaderView::section {
    background: #1d2b38; color: #a9bac9; font-weight: 500; font-size: 12px;
    border: none; padding: 5px 5px;
}
QLabel#emptyList { background: #111a24; color: #a3b5c1; border-radius: 6px; padding: 14px 4px; }
QFrame#metricStrip { background: #1b2a36; border-radius: 7px; }
QPushButton#readout { background: transparent; color: #eaf5f6; font: 600 23px "Segoe UI"; text-align: left; padding: 0; }
QPushButton#readout:hover { color: #8ae0d0; }
QFrame#sectionRule { background: #2c3946; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit, QTextBrowser {
    background: #101923; color: #e4edf3; border: 1px solid #344454;
    border-radius: 5px; padding: 4px 8px; min-height: 20px; selection-background-color: #34645f;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
    border-color: #71b8b1;
}
QLineEdit:disabled, QSpinBox:disabled { color: #788896; border-color: #283542; }
QSpinBox#thresholdValue { background: #1c2c39; color: #c9e9e5; font-weight: 600; min-width: 48px; padding: 3px 5px; }
QSpinBox#thresholdValue::up-button, QSpinBox#thresholdValue::down-button {
    width: 15px; border: none; background: transparent;
}
QSpinBox#thresholdValue::up-button:hover, QSpinBox#thresholdValue::down-button:hover { background: #314555; }
QSpinBox QLineEdit, QDoubleSpinBox QLineEdit {
    background: transparent; border: none; border-radius: 0; padding: 0; min-height: 0;
}
QSlider#roiThreshold::groove:horizontal { height: 4px; background: #344453; border-radius: 2px; }
QSlider#roiThreshold::sub-page:horizontal { background: #67bdaf; border-radius: 2px; }
QSlider#roiThreshold::handle:horizontal { width: 12px; margin: -4px 0; background: #b7eee0; border-radius: 6px; }
QFrame#segments { background: #0e1720; border-radius: 7px; }
QPushButton#segment { background: transparent; color: #a6b7c5; padding: 3px 2px; font-size: 13px; }
QPushButton#segment:hover { background: #233340; }
QPushButton#segment:checked { background: #29413f; color: #bdf0df; }
QPushButton#segment:disabled { color: #748392; }
QLabel#audit { color: #9aabba; font-size: 12px; padding-top: 5px; }
QFrame#statusBar { background: #101923; border-top: 1px solid #273542; }
QLabel#footer { color: #afc2ce; font-size: 12px; }
QSplitter::handle { background: #0c121b; }
QSplitter::handle:hover { background: #2a424c; }
QScrollBar:vertical { background: transparent; width: 7px; margin: 0; }
QScrollBar::handle:vertical { background: #40515e; border-radius: 3px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip { background: #263644; color: #f0f5f8; border: 1px solid #45606d; padding: 5px; }
