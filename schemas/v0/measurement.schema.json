{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JennyTuan/DMT/schemas/v0/measurement.schema.json",
  "title": "Measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "measurement_id",
    "lesion_id",
    "suv_max",
    "longest_diameter_mm",
    "edited",
    "state",
    "audit"
  ],
  "properties": {
    "measurement_id": {
      "type": "string"
    },
    "lesion_id": {
      "type": "string"
    },
    "suv_max": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "longest_diameter_mm": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "roi_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "edited": {
      "type": "boolean"
    },
    "state": {
      "$ref": "finding_state.schema.json#/$defs/status"
    },
    "audit": {
      "type": "array",
      "items": {
        "$ref": "finding_state.schema.json#/$defs/audit_entry"
      }
    }
  }
}
