{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dmt:lungct:v1",
  "title": "肺结节 P0 领域契约",
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "selected_series": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project_id",
        "name",
        "operator",
        "created_at",
        "selected_series"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_code": {
          "type": "string"
        },
        "authorized": {
          "const": true
        },
        "deidentified": {
          "const": true
        },
        "pixels_checked": {
          "const": true
        },
        "adult_chest": {
          "const": true
        },
        "noncontrast": {
          "const": true
        },
        "research_source": {
          "enum": [
            "screening",
            "non_screening",
            "unknown"
          ]
        }
      },
      "required": [
        "source_code",
        "authorized",
        "deidentified",
        "pixels_checked",
        "adult_chest",
        "noncontrast",
        "research_source"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "series_key": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "enum": [
            "ai",
            "manual"
          ]
        },
        "center_lps": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "slice_key": {
          "type": "string"
        },
        "box_lps": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "project_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "series_key",
        "run_id",
        "source",
        "center_lps",
        "slice_key",
        "box_lps",
        "score",
        "project_id",
        "label"
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "type": "string"
        },
        "finding_id": {
          "type": "string"
        },
        "previous_revision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "confirmed",
            "excluded",
            "uncertain"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "center_lps": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "slice_key": {
          "type": "string"
        },
        "side": {
          "enum": [
            "left",
            "right",
            "unknown"
          ]
        },
        "lobe": {
          "enum": [
            "RUL",
            "RML",
            "RLL",
            "LUL",
            "LLL",
            "unknown"
          ]
        },
        "nodule_type": {
          "enum": [
            "solid",
            "part_solid",
            "ground_glass",
            "unknown"
          ]
        },
        "long_axis": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/axis"
            }
          ]
        },
        "short_axis": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/axis"
            }
          ]
        },
        "contour": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "points_lps": {
              "type": "array",
              "minItems": 3,
              "maxItems": 512,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "number" }
              }
            },
            "slice_key": { "type": "string" },
            "method": { "const": "manual_axial_lps" }
          },
          "required": ["points_lps", "slice_key", "method"]
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "revision_id",
        "finding_id",
        "previous_revision_id",
        "operator",
        "at",
        "action",
        "state",
        "reason",
        "center_lps",
        "slice_key",
        "side",
        "lobe",
        "nodule_type",
        "long_axis",
        "short_axis",
        "missing_reason"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "series_key": {
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "input_sha256": {
          "type": "string"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "object",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "project_id": {
          "type": "string"
        },
        "request_key": {
          "type": "string"
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initial_revisions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "model_to_lps": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "run_id",
        "series_key",
        "state",
        "complete",
        "input_sha256",
        "model",
        "error_code",
        "candidate_count",
        "project_id",
        "request_key",
        "threshold",
        "created_at",
        "finding_ids",
        "initial_revisions",
        "elapsed_seconds",
        "message"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "study_key": {
          "type": "string"
        },
        "series_key": {
          "type": "string"
        },
        "draft_id": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis_mode": {
          "enum": [
            "manual",
            "ai"
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "operator": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision"
          }
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "sha256": {
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/run"
            }
          ]
        },
        "heads": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "research_source": {
          "enum": [
            "screening",
            "non_screening",
            "unknown"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "run_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      },
      "required": [
        "snapshot_id",
        "project_id",
        "study_key",
        "series_key",
        "draft_id",
        "run_id",
        "analysis_mode",
        "completed_at",
        "operator",
        "findings",
        "revisions",
        "counts",
        "sha256",
        "run",
        "heads",
        "research_source",
        "synthetic",
        "run_history"
      ]
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string"
        },
        "study_key": {
          "type": "string"
        },
        "subject_key": {
          "type": "string"
        },
        "case_code": {
          "type": "string"
        },
        "selected_series": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "reviewing",
            "completed"
          ]
        }
      },
      "required": [
        "project_id",
        "study_key",
        "subject_key",
        "case_code",
        "selected_series",
        "status"
      ]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origins": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "row": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "column": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "normal": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "spacing": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "origins",
        "row",
        "column",
        "normal",
        "spacing",
        "rows",
        "columns",
        "locations"
      ]
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string"
        },
        "study_key": {
          "type": "string"
        },
        "series_key": {
          "type": "string"
        },
        "subject_key": {
          "type": "string"
        },
        "slice_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eligible": {
          "type": "boolean"
        },
        "qc_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qc_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "geometry": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/geometry"
            }
          ]
        },
        "thickness_mm": {
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "input_sha256": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "project_id",
        "study_key",
        "series_key",
        "subject_key",
        "slice_keys",
        "eligible",
        "qc_codes",
        "qc_metrics",
        "geometry",
        "thickness_mm",
        "source",
        "input_sha256",
        "synthetic"
      ]
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 2,
          "maxItems": 2
        },
        "length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "slice_key": {
          "type": "string"
        },
        "method": {
          "const": "manual_axial_lps"
        }
      },
      "required": [
        "endpoints",
        "length_mm",
        "slice_key",
        "method"
      ]
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "study_key": {
          "type": "string"
        },
        "series_key": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis_mode": {
          "enum": [
            "manual",
            "ai"
          ]
        },
        "operator": {
          "type": "string"
        },
        "status": {
          "enum": [
            "reviewing",
            "completed"
          ]
        },
        "heads": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_id": {
          "type": "string"
        },
        "reopened_from": {
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "project_id",
        "study_key",
        "series_key",
        "run_id",
        "analysis_mode",
        "operator",
        "status",
        "heads",
        "version",
        "created_at"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ai": {
          "type": "integer",
          "minimum": 0
        },
        "manual": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ai",
        "manual",
        "confirmed",
        "excluded",
        "uncertain",
        "pending"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "original": {
          "$ref": "#/$defs/finding"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "finding_id",
        "label",
        "original",
        "revision"
      ]
    }
  }
}
